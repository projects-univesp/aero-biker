<script src="/js/schedule.js"></script>

<div class="flex-1 overflow-y-auto p-4 lg:p-6">
  <div class="space-y-6">

    {{> top
      tagName="Agenda de Aulas"
      tagButton="Nova Aula"
      tagId="schedule-counters"
      action="handleOpen(null, APP_CONFIG.SCHEDULES)"
    }}

    <div class="flex flex-col sm:flex-row gap-3">

      {{> search
        tagId="search-input"
        tagPlaceholder="Buscar aula..."
      }}

      <div class="flex gap-2">

        <button
          id="btn-all"
          data-filter="all"
          class="filter-btn px-4 py-2.5 rounded-xl text-sm font-medium bg-green-500 text-white"
        >
          todas
        </button>

        <button
          id="btn-active"
          data-filter="active"
          class="filter-btn px-4 py-2.5 rounded-xl text-sm font-medium bg-white border border-gray-200 text-gray-600"
        >
          ativas
        </button>

        <button
          id="btn-inactive"
          data-filter="inactive"
          class="filter-btn px-4 py-2.5 rounded-xl text-sm font-medium bg-white border border-gray-200 text-gray-600"
        >
          inativas
        </button>

      </div>
    </div>

    {{#if isEmpty}}
      {{> emptyState }}
    {{else}}
      {{> scheduleList }}
    {{/if}}

  </div>
</div>

{{> scheduleModal }}