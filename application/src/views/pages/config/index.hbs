<script src="/js/settings.js"></script>

<div class="flex-1 overflow-y-auto p-4 lg:p-6">
  <div class="max-w-2xl space-y-6">

    <div>
      <h1 class="text-xl font-semibold text-gray-900">Configurações</h1>
      <p class="text-sm text-gray-500 mt-1">Gerencie os dados da academia e sua senha de acesso.</p>
    </div>

    {{!-- Academia --}}
    <div class="bg-white border border-gray-200 rounded-2xl p-6">
      <h2 class="text-base font-semibold text-gray-900 mb-4">Dados da Academia</h2>

      <div id="academy-error" class="hidden mb-4 p-3 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm"></div>
      <div id="academy-success" class="hidden mb-4 p-3 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm"></div>

      <form id="academy-form" class="space-y-4" novalidate>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Nome da academia</label>
          <input
            id="academy-name"
            type="text"
            value="{{academy.name}}"
            placeholder="Nome da academia"
            class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-green-300 bg-white"
          >
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">CNPJ</label>
            <input
              id="academy-cnpj"
              type="text"
              value="{{academy.cnpj}}"
              placeholder="00.000.000/0000-00"
              class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-green-300 bg-white"
            >
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Telefone</label>
            <input
              id="academy-phone"
              type="text"
              value="{{academy.phone}}"
              placeholder="(00) 00000-0000"
              class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-green-300 bg-white"
            >
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Endereço</label>
          <input
            id="academy-address"
            type="text"
            value="{{academy.address}}"
            placeholder="Rua, número, bairro, cidade"
            class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-green-300 bg-white"
          >
        </div>

        <div class="flex justify-end">
          <button
            id="academy-btn"
            type="submit"
            data-label="Salvar alterações"
            class="px-6 py-2.5 bg-green-500 hover:bg-green-400 text-white font-semibold rounded-xl text-sm transition-colors disabled:opacity-50"
          >
            Salvar alterações
          </button>
        </div>
      </form>
    </div>

    {{!-- Alterar senha --}}
    <div id="change-password" class="bg-white border border-gray-200 rounded-2xl p-6">
      <h2 class="text-base font-semibold text-gray-900 mb-4">Alterar senha</h2>

      <div id="password-error" class="hidden mb-4 p-3 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm"></div>
      <div id="password-success" class="hidden mb-4 p-3 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm"></div>

      <form id="password-form" class="space-y-4" novalidate>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Senha atual</label>
          <input
            id="current-password"
            type="password"
            autocomplete="current-password"
            placeholder="••••••••"
            class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-green-300 bg-white"
          >
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Nova senha</label>
          <input
            id="new-password"
            type="password"
            autocomplete="new-password"
            placeholder="Mínimo 8 caracteres"
            class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-green-300 bg-white"
          >
        </div>

        <div class="flex justify-end">
          <button
            id="password-btn"
            type="submit"
            data-label="Alterar senha"
            class="px-6 py-2.5 bg-green-500 hover:bg-green-400 text-white font-semibold rounded-xl text-sm transition-colors disabled:opacity-50"
          >
            Alterar senha
          </button>
        </div>
      </form>
    </div>

    {{!-- Link para gerenciar usuários --}}
    {{#if (eq currentUser.role "OWNER")}}
    <a href="/config/users" class="flex items-center justify-between bg-white border border-gray-200 rounded-2xl p-5 hover:border-green-300 transition-colors group">
      <div>
        <p class="font-medium text-gray-900 text-sm">Gerenciar usuários</p>
        <p class="text-xs text-gray-500 mt-0.5">Adicionar ou desativar contas de acesso ao sistema</p>
      </div>
      <svg class="w-5 h-5 text-gray-400 group-hover:text-green-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
    {{/if}}
    {{#if (eq currentUser.role "ADMIN")}}
    <a href="/config/users" class="flex items-center justify-between bg-white border border-gray-200 rounded-2xl p-5 hover:border-green-300 transition-colors group">
      <div>
        <p class="font-medium text-gray-900 text-sm">Gerenciar usuários</p>
        <p class="text-xs text-gray-500 mt-0.5">Adicionar ou desativar contas de acesso ao sistema</p>
      </div>
      <svg class="w-5 h-5 text-gray-400 group-hover:text-green-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
    {{/if}}

  </div>
</div>
