<script src="/js/dashboard.js"></script>

<div class="flex-1 overflow-y-auto p-4">
    <div class="space-y-6">
        {{> top tagName="Dashboard" tagId="dashboard-subtitle" }}
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mt-6">
      {{> dashCard
        title="Alunos Ativos"
        value=dashboard.totalStudents
        icon="icons/users"
      }}
    
      {{> dashCard
        title="Turmas"
        value=dashboard.totalClasses
        icon="icons/bike"
      }}
    
      {{> dashCard
        title="Aulas Cadastradas"
        value=dashboard.totalLessons
        icon="icons/calendar"
      }}

      {{> dashCard
        title="Planos Ativos"
        value=dashboard.totalPlans
        icon="icons/cred-card"
      }}
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-6">
      {{> revenueCard
        month="Maio"
        amount="0,00"
        paid=0
        pending=0
      }}
    
      {{> estimateCard
        estimate="678,33"
      }} 
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-6">
      {{> recentClassesCard
        recentClasses=dashboard.recentClasses
      }}
    
      {{> renewalsCard
        upcomingRenewals=dashboard.upcomingRenewals
      }}
    </div>
    
</div>