<script src="/js/dashboard.js"></script>

<div class="flex-1 overflow-y-auto p-4">
    <div class="space-y-6">
        {{> top tagName="Dashboard" tagId="dashboard-subtitle" }}
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mt-6">
      {{> dashCard
        title="Alunos Ativos"
        value=dashboard.activeStudents
        icon="icons/users"
      }}

      {{> dashCard
        title="Turmas"
        value=dashboard.activeGroups
        icon="icons/bike"
      }}

      {{> dashCard
        title="Aulas Cadastradas"
        value=dashboard.totalLessons
        icon="icons/calendar"
      }}

      {{> dashCard
        title="Planos Ativos"
        value=dashboard.activePlans
        icon="icons/cred-card"
      }}
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-6">
      {{> revenueCard
        month=dashboard.revenue.month
        amount=dashboard.revenue.amount
        paid=dashboard.revenue.paid
        pending=dashboard.revenue.pending
      }}
    
      {{> estimateCard
        estimate=dashboard.estimate
      }} 
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-6">
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 h-[300px] flex flex-col">
        <h3 class="text-sm font-bold text-gray-900 mb-4">Alunos por Turma</h3>
        <div class="flex-1 relative w-full h-full">
          <canvas id="studentsPerGroupChart"></canvas>
        </div>
      </div>
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 h-[300px] flex flex-col">
        <h3 class="text-sm font-bold text-gray-900 mb-4">Distribuição de Planos</h3>
        <div class="flex-1 relative w-full h-full flex items-center justify-center">
          <canvas id="planDistributionChart"></canvas>
        </div>
      </div>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-6">
      {{> recentClassesCard
        recentClasses=dashboard.recentClasses
      }}
    
      {{> renewalsCard
        upcomingRenewals=dashboard.upcomingRenewals
      }}
    </div>
    
</div>

<script id="dashboard-data" type="application/json">
  {{{json dashboard}}}
</script>