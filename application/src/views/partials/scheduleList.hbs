<div class="space-y-4">

  {{#each schedules}}
    <div
      class="schedule-row bg-white rounded-2xl border-gray-100 p-0.5 flex items-center justify-between shadow-md transition"
      data-name="{{this.title}}"
      data-status="{{#if this.isActive}}active{{else}}inactive{{/if}}"
      data-date="{{this.dayAndMonth}}"
    >

      <div class="flex items-center gap-1">
        <div class="ml-2 w-14 h-14 rounded-2xl bg-green-100 flex flex-col items-center justify-center shrink-0">
            <span class="text-green-700 text-lg font-bold">
              {{formatDay this.dayAndMonth}}
            </span>
            <span class="text-green-600 text-xs font-medium uppercase">
              {{formatMonthShort this.dayAndMonth}}
            </span>
        </div>

        <div>
          <div class="flex items-center gap-10 flex-wrap">
            <h3 class="font-semibold text-gray-900 text-sm">
              {{this.title}}
            </h3>
          </div>

          <div class="flex gap-2 mt-1 flex-wrap">
            <span class="text-xs px-2 py-1 rounded-full bg-green-100 text-green-700 flex">
              {{this.level}}
            </span>
            <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-600">
              {{this.category}}
            </span>
            {{#if this.isHoliday}}
              <span class="text-xs px-2 py-1 rounded-full bg-red-100 text-red-600">
                Feriado
              </span>
            {{/if}}
          </div>

          <p class="text-xs text-gray-500 mt-2">
            {{this.description}}
          </p>
          <div class="flex items-center gap-3 mt-2 text-xs text-gray-400">
            <span>
              {{formatTime this.startTime}} - {{formatTime this.endTime}}
            </span>
            <span>
              Turma: {{this.group.name}}
            </span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1 px-3 py-2 bg-green-50 rounded-xl text-sm text-green-700">
          {{> icons/scheduleUsers class="w-4 h-4"}}
          {{this.currentStudents}}
        </div>

        <button
          onclick="handleOpen('{{this.id}}', APP_CONFIG.SCHEDULES)"
          class="p-2 text-gray-400 hover:text-green-500 hover:bg-green-50 rounded-lg transition"
          title="Editar"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
          </svg>
        </button>

        <button
          onclick="handleDelete('{{this.id}}', 'schedules')"
          class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition"
          title="Excluir"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
          </svg>
        </button>
      </div>

    </div>
  {{else}}

    <div class="bg-white rounded-2xl p-8 text-center text-gray-500">
      Nenhuma aula encontrada.
    </div>

  {{/each}}

</div>
