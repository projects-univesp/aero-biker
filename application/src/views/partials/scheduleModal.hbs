{{#> modal
  modalId="modal-schedule"
  titleId="schedule-modal-title"
  formId="schedule-form"
  hiddenId="schedule-id"
  configName="APP_CONFIG.SCHEDULES"
  title="Nova Aula"
}}
  <div class="max-h-[55vh] overflow-y-auto space-y-4 pr-1">

    <div>
      <label class="text-sm font-medium text-gray-700 block mb-1.5">Título da Aula*</label>
      <input type="text" id="schedule-title" placeholder="Ex: ROCK HIIT" class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-300">
    </div>

    <div>
      <label class="text-sm font-medium text-gray-700 block mb-1.5">Categoria*</label>
      <input type="text" id="schedule-category" placeholder="Ex: HIIT" class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-300">
    </div>

    <div>
      <label class="text-sm font-medium text-gray-700 block mb-1.5">Nível*</label>
      <select id="schedule-level" class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-300 bg-white">
        <option value="">Selecione o nível</option>
        <option value="Iniciante">Iniciante</option>
        <option value="Intermediário">Intermediário</option>
        <option value="Avançado">Avançado</option>
      </select>
    </div>

    <div>
      <label class="text-sm font-medium text-gray-700 block mb-1.5">Descrição</label>
      <input type="text" id="schedule-description" placeholder="Descrição da aula" class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-300">
    </div>

    <div>
      <label class="text-sm font-medium text-gray-700 block mb-1.5">Data da Aula*</label>
      <input type="date" id="schedule-date" class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-300">
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="text-sm font-medium text-gray-700 block mb-1.5">Início*</label>
        <input type="time" id="schedule-start" class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-300">
      </div>
      <div>
        <label class="text-sm font-medium text-gray-700 block mb-1.5">Fim*</label>
        <input type="time" id="schedule-end" class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-300">
      </div>
    </div>

    <div>
      <label class="text-sm font-medium text-gray-700 block mb-1.5">Qtd. Alunos(as)*</label>
      <input type="number" min="0" id="schedule-current-students" placeholder="Ex.: 3" class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-300">
    </div>

    <div>
      <label class="text-sm font-medium text-gray-700 block mb-1.5">Turma*</label>
      <select id="schedule-group" class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-300 bg-white">
        <option value="">Selecione a turma</option>
      </select>
    </div>

    <label class="flex items-center gap-3 cursor-pointer">
      <input type="checkbox" id="schedule-holiday" class="w-4 h-4 accent-green-500">
      <span class="text-sm font-medium text-gray-700">Feriado</span>
    </label>

    <label class="flex items-center gap-3 cursor-pointer">
      <input type="checkbox" id="schedule-active" class="w-4 h-4 accent-green-500" checked>
      <span class="text-sm font-medium text-gray-700">Aula ativa</span>
    </label>

  </div>
{{/modal}}
