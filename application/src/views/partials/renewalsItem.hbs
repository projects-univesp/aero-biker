<a
  href="/subscriptions"
  class="flex items-center justify-between rounded-xl bg-gray-50 px-4 py-3 hover:bg-gray-100 hover:shadow-sm transition-all cursor-pointer block"
>
  <div>
    <p class="font-medium text-gray-900">
      {{student}}
    </p>
    <p class="text-sm text-gray-500 mt-0.5">
      Plano {{plan}} <span class="text-gray-300 mx-1">•</span> <span class="font-semibold text-green-600">R$ {{value}}</span>
    </p>
  </div>

  <span class="text-xs font-medium text-gray-500 bg-white border border-gray-200 px-2 py-1 rounded-md">
    {{expiresAt}}
  </span>
</a>