<div class="bg-white rounded-2xl shadow-sm border border-gray-100 px-6 py-5 flex items-center justify-between">

  <!-- Botão esquerda -->
  <button
    id="prevMonthBtn"
    class="p-2 text-gray-400 hover:text-gray-700 transition-colors"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m15 18-6-6 6-6"/>
    </svg>
  </button>

  <!-- Mês central -->
  <div class="text-center">
    <p
      id="currentMonthLabel"
      class="font-bold text-gray-900 text-2xl"
    >
      Fevereiro
    </p>

    <p
      id="currentYearLabel"
      class="text-sm text-gray-400 mt-1"
    >
      2025
    </p>
  </div>

  <!-- Botão direita -->
  <button
    id="nextMonthBtn"
    class="p-2 text-gray-400 hover:text-gray-700 transition-colors"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m9 18 6-6-6-6"/>
    </svg>
  </button>
</div>