{{#if isEmpty}}
  <section class="rounded-2xl border border-dashed border-gray-200 bg-white p-8 text-center">
    <h2 class="text-lg font-semibold text-gray-900">
      {{emptyMessage}}
    </h2>

    {{#if category}}
      <p class="mt-2 text-sm text-gray-500">
        Categoria: {{category}}
      </p>
    {{/if}}
  </section>
{{/if}}
