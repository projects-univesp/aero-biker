<div>
    <label class="text-sm font-medium text-zinc-200 block mb-1.5">{{label}}</label>
    <select id="{{id}}" class="w-full border border-zinc-400 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-300 disabled:bg-gray-50">
        <option value="">Selecione um {{tagCategory}}</option>
        {{#each tagData}}
            <option value="{{this}}">
                {{this}}
            </option>
        {{/each}}
    </select>
</div>