<script src="/js/aside.js"></script>

<aside id="sidebar" class="w-64 flex flex-col bg-gray-900 text-white fixed inset-y-0 left-0 z-50 transform -translate-x-full transition-transform duration-300 md:relative md:translate-x-0">
  <div class="flex items-center gap-3 p-4 border-b border-gray-700">
    <div class="w-10 h-10 bg-black rounded-lg overflow-hidden shrink-0">
      <img src="/img/aero-biker.png.avif" alt="Logo" class="w-full h-full object-cover">
    </div>
    <div>
      <p class="font-bold text-sm leading-none">AEROBIC BIKER</p>
      <span class="text-xs text-gray-400">Spinning Bike</span>
    </div>
  </div>
  
  <nav class="flex-1 overflow-y-auto p-4">
    <ul class="flex flex-col gap-2">
      {{> asideLinks link="/dashboard" label="Dashboard" }}
      {{> asideLinks link="/students" label="Alunos" }}
      {{> asideLinks link="/groups" label="Turmas" }}
      {{> asideLinks link="/ammendements" label="Agenda de Aulas" }}
      {{> asideLinks link="/plans" label="Planos" }}
      {{> asideLinks link="/subscriptions" label="Pagamentos" }}
    </ul>
  </nav>
  
  <div class="px-3 pb-4 border-t border-white/10 pt-3">
    <div class="flex items-center gap-3 px-4 py-3 bg-white/5 rounded-xl mb-2">
      <div class="w-8 h-8 bg-green-500 rounded-lg flex items-center justify-center text-sm font-bold text-white shrink-0">
        {{#if currentUser.name}}{{substring currentUser.name 0 1}}{{else}}A{{/if}}
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-xs font-medium truncate">{{#if currentUser.name}}{{currentUser.name}}{{else}}Administrador{{/if}}</p>
        <p class="text-xs text-gray-500 truncate">{{currentUser.role}}</p>
      </div>
    </div>
    <form method="POST" action="/api/auth/logout" id="logout-form">
      <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 text-white/50 hover:text-red-400 hover:bg-white/5 rounded-xl text-sm transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        Sair
      </button>
    </form>
  </div>
</aside>