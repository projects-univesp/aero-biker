{{#each durationMonths}}
<div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 flex flex-col justify-between plan-summary-card" data-modality="{{this}}">
  <div>
    <span class="text-xs px-2.5 py-1 rounded-full font-medium modality-badge">
      {{this}}
    </span>
    <p class="text-2xl font-bold text-gray-900 mt-2" id="value-{{this}}">R$ 0,00</p>
  </div>
  <p class="text-xs text-gray-500 mt-2 font-medium" id="count-{{this}}">0 ativos</p>
</div>
{{/each}}
