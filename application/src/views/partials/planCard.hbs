{{#each plans}}
<div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100">
   <span class="text-xs px-2.5 py-1 rounded-full font-medium bg-purple-100 text-purple-700">{{this.durationMonths}}
   </span>
   <p class="text-2xl font-bold text-gray-900 mt-2">1</p>
   <p class="font-medium text-sm text-gray-900">{{formatCurrency this.price}}</p>
</div>
{{/each}}