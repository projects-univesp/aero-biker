<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-100">
                <tr>
                    <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Aluno</th>
                    <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider hidden md:table-cell">Plano</th>
                    <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider hidden sm:table-cell">Valor</th>
                    <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider hidden md:table-cell">Método</th>
                    <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider hidden md:table-cell">Renovação</th>
                    <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider hidden md:table-cell">Status</th>
                    <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50" id="subscriptions-table-body">
                {{#each subscriptions}}
                <tr class="subscription-row hover:bg-gray-50 transition-colors" data-status="{{this.status}}">
                    <td class="px-5 py-3.5">
                        <span class="student-name font-medium text-sm text-gray-900" data-student-id="{{this.studentId}}">—</span>
                    </td>
                    <td class="px-5 py-3.5 hidden md:table-cell">
                        <span class="plan-name text-sm text-gray-600" data-plan-id="{{this.planId}}">—</span>
                    </td>
                    <td class="px-5 py-3.5 hidden sm:table-cell">
                        <p class="font-medium text-sm text-gray-900">{{formatCurrency this.subscriptionValue}}</p>
                    </td>
                    <td class="px-5 py-3.5 hidden md:table-cell">
                        <p class="text-sm text-gray-600">{{this.paymentMethod}}</p>
                    </td>
                    <td class="px-5 py-3.5 hidden md:table-cell">
                        <p class="text-sm text-gray-600">{{formatDateShort this.renovationDate}}</p>
                    </td>
                    <td class="px-5 py-3.5 hidden md:table-cell">
                        {{#if (eq this.status "ACTIVE")}}
                            <span class="inline-flex items-center text-xs px-2.5 py-1 rounded-full font-medium bg-green-100 text-green-700">Ativo</span>
                        {{else}}
                            {{#if (eq this.status "INACTIVE")}}
                                <span class="inline-flex items-center text-xs px-2.5 py-1 rounded-full font-medium bg-yellow-100 text-yellow-700">Inativo</span>
                            {{else}}
                                <span class="inline-flex items-center text-xs px-2.5 py-1 rounded-full font-medium bg-red-100 text-red-700">Cancelado</span>
                            {{/if}}
                        {{/if}}
                    </td>
                    <td class="px-5 py-3.5">
                        <div class="flex items-center gap-1.5">
                            <button onclick="handleOpen('{{this.id}}', APP_CONFIG.SUBSCRIPTIONS)" class="p-1.5 text-gray-400 hover:text-green-500 hover:bg-green-50 rounded-lg transition-colors" title="Editar">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
                                </svg>
                            </button>
                            <button onclick="handleDelete('{{this.id}}', 'subscriptions')" class="p-1.5 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors" title="Cancelar">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="7" class="p-6 text-center text-gray-500">Nenhuma assinatura encontrada.</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
